generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Priority {
  Low
  Medium
  High
}

enum Categories {
  SALES
  BILLING
  TECHNICAL
  GENERAL
}

enum Status {
  PENDING
  FULLFILLED
}

enum Source {
  HUMAN
  AI
}

model Request {
  id                    Int        @id @default(autoincrement())
  name                  String
  email                 String     
  message               String
  priority              Priority
  classified_as         Categories
  status                Status
  classification_source Source
  created_at            DateTime   @default(now())
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  created_at DateTime @default(now())
}
